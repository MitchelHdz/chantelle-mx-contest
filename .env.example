# Public configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CAMPAIGN_SLUG=chantelle-vive-paris

# Dedicated Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-the-supabase-secret-key

# Private UploadThing app
UPLOADTHING_TOKEN=replace-with-the-uploadthing-token

# Generate separate, random values of at least 32 characters for each secret.
PII_HASH_SECRET=replace-with-a-32-character-minimum-secret
UPLOAD_INTENT_SECRET=replace-with-a-different-32-character-minimum-secret

# Required in production. Use a Redis REST-compatible rate-limit service.
RATE_LIMIT_REST_URL=https://your-rate-limit-endpoint.example
RATE_LIMIT_REST_TOKEN=replace-with-the-rate-limit-token

# Optional integrations, implemented in the operation milestone.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=
RESEND_API_KEY=
CONFIRMATION_FROM_EMAIL=
